# Data Quality Assistant — Configuration
# Copy this file to .env and set your values.

# AI Provider: "mock" (default, no LLM needed) or "litellm" (real LLM)
AI_PROVIDER=mock

# LiteLLM Settings (only used when AI_PROVIDER=litellm)
# Model identifier — use "openai/<model-name>" for LM Studio
LITELLM_MODEL=openai/google/gemma-4-26b-a4b-qat

# Base URL for your LLM API (e.g., LM Studio)
LITELLM_API_BASE=http://192.168.0.101:1234/v1

# API key (use "not-needed" for local LM Studio)
LITELLM_API_KEY=not-needed

# Generation parameters
LITELLM_TEMPERATURE=0.2
LITELLM_MAX_TOKENS=256
